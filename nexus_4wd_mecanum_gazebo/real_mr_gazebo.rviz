Panels:
  - Class: rviz/Displays
    Help Height: 0
    Name: Displays
    Property Tree Widget:
      Expanded:
        - /Global Options1
        - /uav01
        - /uav01/uav_grid_map1
        - /ugv_01
        - /ugv_01/Odometry1/Shape1
        - /ugv_11
        - /ugv_11/Odometry1/Shape1
        - /ugv_21
        - /ugv_31
        - /ugv_31/Odometry1/Covariance1
