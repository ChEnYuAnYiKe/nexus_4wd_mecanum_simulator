      - /2D Pose Estimate1
      - /2D Nav Goal1
      - /3D Nav Goal1
    Name: Tool Properties
    Splitter Ratio: 0.5886790156364441
  - Class: rviz/Views
    Expanded:
      - /Current View1
    Name: Views
    Splitter Ratio: 0.5
  - Class: rviz/Time
    Name: Time
    SyncMode: 3
    SyncSource: uav_grid_map
Preferences:
  PromptSaveOnExit: true
Toolbars:
  toolButtonStyle: 2
